# Copy to .env and fill in. Never commit .env (it is gitignored).
# Empty values count as "not set".

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys. Try everything with rzp_test_ keys first.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=
# Optional: your account ID (Dashboard → Account & Settings, acc_… or the 14-character merchant ID).
# The tool then tries Razorpay's Accounts API for your registered address and GSTIN.
# Razorpay documents that API for partners, so it may refuse normal keys: `npm run probe` tells you.
RAZORPAY_ACCOUNT_ID=

# ── Data files (keep the real ones out of git; both are gitignored) ────────────
CLIENTS_DATA_PATH=./clients.json
BANK_DETAILS_PATH=./bank-details.json

# ── Billing ───────────────────────────────────────────────────────────────────
# Time zone used for schedules, the billed month and the dates on the PDF.
INVOICE_TIMEZONE=Asia/Kolkata
# Which month an invoice covers: "previous" (run on 1 Nov bills October) or "current".
BILLING_PERIOD=previous
# Invoice number = <prefix>-<YYYYMM>-<client label>, e.g. INV-202610-client-a.
# It is also the Razorpay receipt that stops the same month being invoiced twice.
RECEIPT_PREFIX=INV
# Due date printed on the PDF, in days after the issue date. Leave empty for none.
DUE_IN_DAYS=15
# Let Razorpay also send its own pay-link email/SMS. Off: clients pay by bank transfer.
RAZORPAY_NOTIFY=false

# ── Your business (printed on the PDF) ────────────────────────────────────────
# All optional: your name and logo come from Razorpay (what Razorpay Checkout shows), and
# your address, email and GSTIN too if the Accounts API works for you. Anything set here wins.
BUSINESS_NAME=
# Use \n for line breaks.
BUSINESS_ADDRESS=
BUSINESS_EMAIL=
# Tax lines, e.g. GSTIN / IEC.
BUSINESS_TAX_INFO=
# A local PNG or JPEG to use instead of your Razorpay Checkout logo.
BUSINESS_LOGO_PATH=
SHOW_LOGO=true
# Optional footer, e.g. "Supply meant for export under LUT without payment of IGST.\nLUT ARN: ..."
INVOICE_FOOTER=
# Optional .ttf/.otf font for names the built-in Helvetica cannot draw (Cyrillic, CJK, ...).
PDF_FONT_PATH=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Works with any SMTP provider: Gmail/Google Workspace (app password), Zoho, Amazon SES, Postmark, ...
SMTP_HOST=smtp.example.com
SMTP_PORT=465
# true for port 465 (TLS); false for 587 (STARTTLS).
SMTP_SECURE=true
# With SMTP_SECURE=false, refuse servers that don't offer STARTTLS. Only turn off for a local relay.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Your Name <billing@example.com>"
EMAIL_REPLY_TO=
# Gets the invoice summaries, payment updates, settlement reports and failure alerts.
OWNER_EMAIL=you@example.com
# Email each client their invoice PDF with the bank-transfer details.
SEND_CLIENT_EMAILS=true
# Email clients a "payment received" receipt when Razorpay captures their transfer, and
# reminders after the due date. Off until you have checked, with `npm run probe` and
# `npm run payments -- --dry-run`, that your MoneySaver transfers are matched correctly.
SEND_PAYMENT_RECEIPTS=false
SEND_REMINDERS=false
# Days after the due date on which reminders go out.
REMINDER_DAYS=3,10

# ── Running ───────────────────────────────────────────────────────────────────
# Keep copies of PDFs (OUTPUT_DIR/<YYYY-MM>/) and settlement reports (OUTPUT_DIR/reports/). Gitignored.
SAVE_OUTPUT=true
OUTPUT_DIR=./output
# What the payment checks remember (payments seen, receipts and reminders sent). Gitignored.
STATE_PATH=./data/state.json
# When `npm start` runs each job (cron syntax, in INVOICE_TIMEZONE). "off" disables a job.
INVOICE_SCHEDULE=0 9 1 * *
PAYMENT_CHECK_SCHEDULE=0 10 * * *
REPORT_SCHEDULE=0 9 3 * *
# On start-up, run the invoices immediately if today is within the first N days of the month,
# in case the server was down on the 1st. Safe: existing invoices are skipped. 0 disables.
CATCH_UP_DAYS=3
# Force dry runs: no invoices created, nothing recorded, no client emails.
DRY_RUN=false
